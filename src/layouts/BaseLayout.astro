---
import '../styles/global.css';
import { siteConfig } from '../lib/content';

interface Props {
	title: string;
	description?: string;
	siteName?: string;
}

const { title, description = '', siteName = siteConfig.name } = Astro.props;
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';
const rssHref = siteUrl ? `${siteUrl}/rss.xml` : '/rss.xml';
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		<meta property="og:title" content={fullTitle} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:type" content="website" />
		{siteUrl && <meta property="og:url" content={siteUrl} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="Writings" href={rssHref} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="wrap">
			<slot />
		</div>
	</body>
</html>
